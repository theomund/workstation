FROM quay.io/almalinuxorg/almalinux-bootc@sha256:c02700e75fdffaa98c6f3a9994a27effb85a041f80f5dc3ad3bb9dacfca426af
RUN --mount=type=tmpfs,target=/var/cache \
    --mount=type=cache,target=/var/cache/dnf,id=dnf-installer \
    --mount=type=tmpfs,target=/var/lib \
    --mount=type=tmpfs,target=/var/log \
    --mount=type=tmpfs,target=/run \
    <<EOF
set -eux

dnf install -y --setopt=keepcache=1 \
  anaconda-dracut-40.22.3.57 \
  anaconda-install-img-deps-40.22.3.57 \
  anaconda-tui-40.22.3.57 \
  dracut-config-generic-107 \
  fuse-overlayfs-1.17 \
  grub2-efi-x64-cdboot-2.12 \
  squashfs-tools-4.6.1 \
  xorriso-1.5.6

cp -a /usr/lib/bootupd/updates/EFI /boot/efi/
EOF
COPY rootfs /
ARG TAG
RUN <<EOF
set -eux

kver=$(basename /usr/lib/modules/*)
sed -i "s|@TAG@|${TAG}|g" /usr/share/anaconda/workstation-installer.ks
dracut -fva anaconda -I /usr/share/anaconda/workstation-installer.ks "/usr/lib/modules/${kver}/initramfs.img" "${kver}"

bootc container lint --fatal-warnings --skip nonempty-boot
EOF
