ARG BASE
ARG CHUNKAH_OUTPUT

FROM ${BASE} AS rootfs
RUN --mount=type=bind,source=target/payload,target=/tmp/RPMS,z \
    --mount=type=tmpfs,target=/run \
    --mount=type=tmpfs,target=/var/cache \
    --mount=type=tmpfs,target=/var/lib \
    --mount=type=tmpfs,target=/var/log <<'EOF'
dnf install -y \
  https://download1.rpmfusion.org/free/el/rpmfusion-free-release-10.noarch.rpm \
  https://download1.rpmfusion.org/nonfree/el/rpmfusion-nonfree-release-10.noarch.rpm \
  /tmp/RPMS/*-repo-*.rpm

dnf install -y \
  @multimedia \
  @sound-and-video \
  @workstation-product-environment \
  /tmp/RPMS/*.rpm
EOF
RUN bootc container lint --fatal-warnings

FROM quay.io/coreos/chunkah@sha256:8b56578258d1d10d3e1c7b0f71a4d05317c5fde331c4f483576a1b60e65f0cea
ARG CHUNKAH_CHOWN
ARG CHUNKAH_CONFIG_STR
RUN --mount=from=rootfs,target=/chunkah,ro \
    --mount=type=bind,target=/run/src,rw <<'EOF'
chunkah build \
  --label ostree.commit- \
  --label ostree.final-diffid- \
  --max-layers 128 \
  --output oci:/run/src/out \
  --prune /sysroot/

chown -R ${CHUNKAH_CHOWN} /run/src/out
EOF

FROM oci:${CHUNKAH_OUTPUT}
