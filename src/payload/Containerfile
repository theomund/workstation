ARG BASE
ARG CHUNKAH_OUTPUT

FROM ${BASE} AS rootfs
COPY rootfs/etc/yum.repos.d /etc/yum.repos.d
RUN --mount=type=tmpfs,target=/var/cache \
    --mount=type=cache,target=/var/cache/dnf,id=dnf-payload \
    --mount=type=tmpfs,target=/var/lib \
    --mount=type=tmpfs,target=/var/log \
    --mount=type=tmpfs,target=/run \
    <<EOF
set -eux

dnf install -y --setopt=keepcache=1 \
  almalinux-release-nvidia-driver-10 \
  https://download1.rpmfusion.org/free/el/rpmfusion-free-release-10.noarch.rpm

dnf install -y --setopt=keepcache=1 -x PackageKit-command-not-found \
  @workstation-product-environment \
  bcvk-0.10.0 \
  cockpit-machines-348.1 \
  code-1.143.1 \
  ffmpeg-7.1.5 \
  kmod-nvidia-open-615.71.10 \
  nvidia-driver-615.71.10 \
  nvidia-driver-cuda-615.71.10 \
  thunderbird-153.5.0 \
  tmux-3.3a
EOF
COPY rootfs /
RUN <<EOF
set -eux

systemctl preset-all
bootc container lint --fatal-warnings
EOF

FROM quay.io/coreos/chunkah@sha256:71e593421c5de7dcc7c8c5c50e98d3bac572055a76f399f61a491d123c20a523
ARG CHUNKAH_CHOWN
ARG CHUNKAH_CONFIG_STR
ARG CHUNKAH_OUTPUT
RUN --mount=from=rootfs,target=/chunkah,ro \
    <<EOF
set -eux

OUTPUT=/run/src/$(basename ${CHUNKAH_OUTPUT})

rm -rf ${OUTPUT}

chunkah build \
  --label ostree.commit- \
  --label ostree.final-diffid- \
  --max-layers 128 \
  --output oci:${OUTPUT} \
  --prune /sysroot/

chown -R ${CHUNKAH_CHOWN} ${OUTPUT}
EOF

FROM oci:${CHUNKAH_OUTPUT}
