[Unit]
Description=Payload component of workstation image
Wants=network-online.target
After=network-online.target plymouth-start.service
Before=systemd-user-sessions.service

[Service]
Type=oneshot
ExecStartPre=-/usr/bin/plymouth display-message --text="Installing Flatpak applications."
ExecStart=/usr/bin/flatpak preinstall --noninteractive

[Install]
WantedBy=graphical.target
