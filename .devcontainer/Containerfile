FROM quay.io/almalinuxorg/almalinux:10.2-20261002
RUN --mount=type=tmpfs,target=/var/cache \
    dnf install -y \
    epel-release-10 \
    && dnf install -y \
    bash-completion-2.11 \
    git-2.52.0 \
    gnupg2-2.4.5 \
    https://github.com/anchore/grype/releases/download/v0.120.0/grype_0.120.0_linux_amd64.rpm \
    https://github.com/anchore/syft/releases/download/v1.54.0/syft_1.54.0_linux_amd64.rpm \
    https://github.com/go-task/task/releases/download/v3.54.0/task_3.54.0_linux_amd64.rpm \
    image-builder-52.1 \
    rpmdevtools-9.6 \
    rpmlint-2.8.0 \
    ShellCheck-0.10.0 \
    sudo-1.9.17 \
    xorriso-1.5.6 \
    yamllint-1.37.1 \
    && chmod 0400 /etc/shadow \
    && sed -i 's/^#cgroups = "enabled"/cgroups = "disabled"/' /usr/share/containers/containers.conf \
    && sed -i 's/^mountopt/#&/; s/^#mount_program =.*/mount_program = ""/' /usr/share/containers/storage.conf \
    && echo "%wheel ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/wheel \
    && chmod 0440 /etc/sudoers.d/wheel \
    && useradd -m -G wheel developer
USER developer
RUN echo -e "%_release %{getenv:RELEASE}\n%_version %{getenv:VERSION}" > /home/developer/.rpmmacros
VOLUME ["/var/cache/image-builder/store", "/var/lib/containers/storage"]
