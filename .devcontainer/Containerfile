FROM quay.io/almalinuxorg/almalinux@sha256:112a396798d93f15b66f19786d553ed3f37d4503db71a92a871748bc731c797c
ENV CONTAINER_HOST=unix:///run/podman/podman.sock
ADD --chmod=755 https://github.com/hadolint/hadolint/releases/download/v2.15.1/hadolint-linux-x86_64 /usr/local/bin/hadolint
ADD --chmod=755 https://github.com/mvdan/sh/releases/download/v3.14.1/shfmt_v3.14.1_linux_amd64 /usr/local/bin/shfmt
# hadolint ignore=DL3041
RUN --mount=type=tmpfs,target=/var/cache \
    --mount=type=tmpfs,target=/var/log \
    <<'EOF'
set -eux

dnf install -y epel-release-10

dnf install -y \
  bash-completion-2.11 \
  git-2.52.0 \
  https://github.com/anchore/grype/releases/download/v0.121.0/grype_0.121.0_linux_amd64.rpm \
  https://github.com/anchore/syft/releases/download/v1.55.0/syft_1.55.0_linux_amd64.rpm \
  https://github.com/go-task/task/releases/download/v3.54.0/task_3.54.0_linux_amd64.rpm \
  podman-remote-5.8.2 \
  ripgrep-14.1.1 \
  ShellCheck-0.10.0 \
  tree-2.1.0 \
  xorriso-1.5.6 \
  yamllint-1.37.1

dnf clean all

useradd -m developer
EOF

USER 1000
