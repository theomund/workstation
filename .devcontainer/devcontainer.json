{
  "name": "workstation",
  "build": {
    "dockerfile": "Containerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-containers",
        "ms-vscode.makefile-tools"
      ]
    }
  },
  "mounts": [
    "source=/var/run/podman/podman.sock,target=/var/run/podman/podman.sock,type=bind"
  ]
}
